NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only geocoding providers. Keep real values in .env.local and hosting secrets.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
PHOTON_API_URL=

# Server-only AI enrichment. Keep real values in .env.local and hosting secrets.
OPENROUTER_API_KEY=
OPENROUTER_PLACE_ENRICHMENT_MODEL=openai/gpt-oss-20b:free
# Web search can add OpenRouter costs even with free models. Keep false for free-model-only enrichment.
OPENROUTER_PLACE_ENRICHMENT_WEB_SEARCH=false

# Required only for local import scripts that write directly to Supabase.
SUPABASE_SERVICE_ROLE_KEY=
