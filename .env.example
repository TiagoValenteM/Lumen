NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only geocoding providers. Keep real values in .env.local and hosting secrets.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
PHOTON_API_URL=

# Server-only AI enrichment. Keep real values in .env.local and hosting secrets.
OPENROUTER_API_KEY=
# Enable only after applying the spot interpretation quota migration.
FIND_A_SPOT_AI_ENABLED=false
OPENROUTER_PLACE_ENRICHMENT_MODEL=openai/gpt-oss-20b:free

# Server-only. A Supabase secret key is preferred for AI and geocoding.
SUPABASE_SECRET_KEY=
# Legacy alternative for the server; also used by the import scripts.
SUPABASE_SERVICE_ROLE_KEY=
